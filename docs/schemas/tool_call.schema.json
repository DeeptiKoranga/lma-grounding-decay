{
  "$defs": {
    "CandidateEvidence": {
      "additionalProperties": false,
      "description": "A passage the verifier considered and did not accept.\n\nKept for failure analysis. It never counts as support, which is why it lives\noutside `evidence_span`.",
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "span": {
          "minLength": 1,
          "title": "Span",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/VerifyVerdict"
        }
      },
      "required": [
        "passage_id",
        "doc_id",
        "span",
        "verdict"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "CounterSearchArgs": {
      "additionalProperties": false,
      "description": "Look for a competing cause of the same move, used on 'why' questions.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "dst_var": {
          "minLength": 1,
          "title": "Dst Var",
          "type": "string"
        },
        "exclude_src_vars": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Exclude Src Vars",
          "type": "array"
        },
        "k": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        }
      },
      "required": [
        "dst_var",
        "direction",
        "as_of"
      ],
      "title": "CounterSearchArgs",
      "type": "object"
    },
    "CounterSearchCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/CounterSearchArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "counter_search",
          "default": "counter_search",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "CounterSearchCall",
      "type": "object"
    },
    "Direction": {
      "description": "Which way the destination variable moves on this edge.",
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "One causal link in an event-impact graph.\n\n`hop` is the distance of this edge's destination from the anchor event: an\nedge leaving the anchor is hop 1. Every headline metric is sliced on it.",
      "properties": {
        "candidate_evidence": {
          "description": "Passages the verifier rejected. Never counts as support.",
          "items": {
            "$ref": "#/$defs/CandidateEvidence"
          },
          "title": "Candidate Evidence",
          "type": "array"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "Which way `dst_var` moves."
        },
        "dst_var": {
          "maxLength": 40,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Dst Var",
          "type": "string"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "evidence_doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document the span was quoted from.",
          "title": "Evidence Doc Id"
        },
        "evidence_passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Passage the span was quoted from, when known.",
          "title": "Evidence Passage Id"
        },
        "evidence_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication timestamp of the evidence, for the as-of check.",
          "title": "Evidence Published At"
        },
        "evidence_span": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim quote from the evidence passage. Required when source_asserted.",
          "title": "Evidence Span"
        },
        "hop": {
          "description": "1 for an edge leaving the anchor event.",
          "exclusiveMinimum": 0,
          "title": "Hop",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "src_var": {
          "maxLength": 40,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Src Var",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifyVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'rules', 'llm', 'rules+llm', 'self-label' (B2) or None.",
          "title": "Verified By"
        }
      },
      "required": [
        "edge_id",
        "src_var",
        "dst_var",
        "direction",
        "provenance",
        "strength",
        "hop"
      ],
      "title": "Edge",
      "type": "object"
    },
    "GetSeriesArgs": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "series_id": {
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "start",
        "end",
        "as_of"
      ],
      "title": "GetSeriesArgs",
      "type": "object"
    },
    "GetSeriesCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/GetSeriesArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "get_series",
          "default": "get_series",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "GetSeriesCall",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "description": "A variable as it appears in one graph, with the move attributed to it.",
      "properties": {
        "confirmed_by_series": {
          "default": false,
          "description": "A macro series confirms the move happened. Never evidence for an edge.",
          "title": "Confirmed By Series",
          "type": "boolean"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "is_anchor": {
          "default": false,
          "title": "Is Anchor",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display label, e.g. 'crude imports'.",
          "title": "Label"
        },
        "series_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Id"
        },
        "var": {
          "maxLength": 40,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Var",
          "type": "string"
        }
      },
      "required": [
        "var",
        "direction"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Provenance": {
      "description": "Where an edge's support comes from. Set only by the verifier in M / A-NoLoop.",
      "enum": [
        "source_asserted",
        "model_inferred"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SearchCorpusArgs": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "description": "Enforced in code; the model cannot widen it.",
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "k": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "must_mention": {
          "description": "Variable ids both of which an evidence passage should mention.",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Must Mention",
          "type": "array"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "source_kind": {
          "default": "any",
          "enum": [
            "news",
            "official",
            "any"
          ],
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "query",
        "as_of"
      ],
      "title": "SearchCorpusArgs",
      "type": "object"
    },
    "SearchCorpusCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/SearchCorpusArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "search_corpus",
          "default": "search_corpus",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "SearchCorpusCall",
      "type": "object"
    },
    "StopArgs": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reason": {
          "enum": [
            "important_edges_resolved",
            "two_searches_added_nothing",
            "budget_exhausted"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StopArgs",
      "type": "object"
    },
    "StopCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/StopArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "stop",
          "default": "stop",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "StopCall",
      "type": "object"
    },
    "Strength": {
      "description": "Causal-strength label, adapted from Yu et al. (2019) and the Causal News Corpus.",
      "enum": [
        "direct",
        "conditional",
        "correlational"
      ],
      "title": "Strength",
      "type": "string"
    },
    "UpdateGraphArgs": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Edge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "op": {
          "enum": [
            "add_node",
            "add_edge",
            "relabel_edge",
            "drop_edge"
          ],
          "title": "Op",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op"
      ],
      "title": "UpdateGraphArgs",
      "type": "object"
    },
    "UpdateGraphCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/UpdateGraphArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "update_graph",
          "default": "update_graph",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "UpdateGraphCall",
      "type": "object"
    },
    "VerifyEdgeArgs": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "passage_ids": {
          "description": "Candidate passages to judge against.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Passage Ids",
          "type": "array"
        }
      },
      "required": [
        "edge_id",
        "as_of"
      ],
      "title": "VerifyEdgeArgs",
      "type": "object"
    },
    "VerifyEdgeCall": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/VerifyEdgeArgs"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "step": {
          "description": "0-based position in the agent loop.",
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "const": "verify_edge",
          "default": "verify_edge",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "step",
        "args"
      ],
      "title": "VerifyEdgeCall",
      "type": "object"
    },
    "VerifyVerdict": {
      "description": "Outcome of one verify_edge call.",
      "enum": [
        "supported",
        "unsupported",
        "contradicted",
        "out_of_corpus",
        "after_as_of"
      ],
      "title": "VerifyVerdict",
      "type": "string"
    }
  },
  "$id": "https://github.com/lma-major/schemas/tool_call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "counter_search": "#/$defs/CounterSearchCall",
      "get_series": "#/$defs/GetSeriesCall",
      "search_corpus": "#/$defs/SearchCorpusCall",
      "stop": "#/$defs/StopCall",
      "update_graph": "#/$defs/UpdateGraphCall",
      "verify_edge": "#/$defs/VerifyEdgeCall"
    },
    "propertyName": "tool"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SearchCorpusCall"
    },
    {
      "$ref": "#/$defs/GetSeriesCall"
    },
    {
      "$ref": "#/$defs/VerifyEdgeCall"
    },
    {
      "$ref": "#/$defs/CounterSearchCall"
    },
    {
      "$ref": "#/$defs/UpdateGraphCall"
    },
    {
      "$ref": "#/$defs/StopCall"
    }
  ]
}
